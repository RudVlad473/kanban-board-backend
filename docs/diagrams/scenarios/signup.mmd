sequenceDiagram
    actor C as Client
    participant A as App
    participant U as users table
    participant S as session store

    C->>A: POST /api/signup<br/>{email, password, displayName?}

    alt body fails validation
        A-->>C: 400 VALIDATION_FAILED<br/>+ errors map
    else body valid
        A->>U: SELECT email in use?
        alt email taken
            A-->>C: 409 DUPLICATE_RESOURCE
        else email free
            A->>U: INSERT user
            alt lost a race on the unique email
                U--xA: unique violation
                A-->>C: 409 DATA_INTEGRITY_VIOLATION
            else row inserted
                Note over A,S: session set up as in POST /api/signin
                A->>S: rotate session id,<br/>save security context
                alt authentication fails
                    A->>U: DELETE user (rollback)
                    A-->>C: 401 BAD_CREDENTIALS<br/>(not 403)
                else authenticated
                    A-->>C: 201 Set-Cookie JSESSIONID<br/>Location /api/users/me<br/>{id, email, displayName, theme}
                end
            end
        end
    end
