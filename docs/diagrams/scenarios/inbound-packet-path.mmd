%%{init: {"flowchart": {"subGraphTitleMargin": {"top": 15, "bottom": 15}, "curve": "linear"}}}%%
flowchart TB
    client["Internet client<br/>(external actor)"]

    netcup_fw["[1] Netcup Cloud Firewall<br/>external, not in this repo<br/>implicit Drop all INCOMING"]

    subgraph vm["Netcup VPS, x86_64<br/>[2] VM host network boundary"]
        direction TB

        vm_spacer[" "]
        style vm_spacer height:1px,fill:none,stroke:none

        mangle_pre["mangle PREROUTING<br/>eth0 jumps to KANBAN-INGRESS"]
        vm_spacer ~~~ mangle_pre
        kanban_ingress["KANBAN-INGRESS [3]<br/>allow RELATED/ESTABLISHED,<br/>NEW tcp 22/80/443, icmp<br/>DROP the rest"]
        nat_pre["nat PREROUTING<br/>dst-type LOCAL jumps to<br/>CNI-HOSTPORT-DNAT"]
        cni_dnat["CNI-HOSTPORT-DNAT<br/>hostPort DNAT 80/443"]

        input["filter INPUT<br/>policy DROP, ACCEPT 22/80/443<br/>host daemons only"]
        sshd["sshd :22<br/>(host daemon, not a Pod)"]

        mangle_pre --> kanban_ingress
        kanban_ingress -- "RETURN (allowed)" --> nat_pre
        nat_pre --> cni_dnat
        mangle_pre -. "host-daemon path,<br/>unaffected by KANBAN-INGRESS" .-> input
        input -. "ACCEPT dpt:22 only" .-> sshd
    end

    subgraph svclb_box["Pod: svclb-traefik, the only<br/>hostPort Pod in the cluster"]
        svclb["svclb-traefik<br/>hostPort 80, 443"]
    end

    client --> netcup_fw
    netcup_fw -- "HTTPS :443<br/>crosses the VM boundary" --> mangle_pre
    cni_dnat -- "DNAT to hostPort 80/443" --> svclb
