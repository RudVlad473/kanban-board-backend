sequenceDiagram
    actor C as Client
    participant A as App
    participant U as users table
    participant S as session store

    C->>A: POST /api/signin<br/>{email, password}

    alt body fails validation
        A-->>C: 400 VALIDATION_FAILED<br/>+ errors map
    else body valid
        A->>U: SELECT user by email
        alt unknown email
            U-->>A: no row
            Note over A: BCrypt compare against<br/>a fixed hash (timing parity)
            A-->>C: 401 BAD_CREDENTIALS
        else known email
            U-->>A: row
            A->>U: SELECT user by id
            Note over A: BCrypt compare
            alt wrong password
                A-->>C: 401 BAD_CREDENTIALS
            else password matches
                A->>S: count live sessions
                alt 2 sessions already live
                    A-->>C: 401 BAD_CREDENTIALS<br/>(identical body)
                else under the ceiling
                    A->>S: rotate session id,<br/>save security context
                    A-->>C: 200 Set-Cookie JSESSIONID<br/>{id, email, displayName, theme}
                    Note over S: rows commit as<br/>the response flushes
                end
            end
        end
    end
