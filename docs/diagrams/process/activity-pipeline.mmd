flowchart TB
    http(["Mutating HTTP request<br/>(request thread)"]) --> tx["Mutation<br/>@Transactional"]
    tx --> commit{{"Transaction commit"}}
    commit ==>|"response returns"| resp(["HTTP response<br/>never waits on Kafka"])
    commit -->|"AFTER_COMMIT"| pub["Publisher<br/>kafka-publish-* executor"]
    pub -.->|"schema-id lookup,<br/>never registers"| registry[["Schema Registry"]]
    pub -->|"Avro, keyed by event id"| topic[["kanban.activity<br/>1 partition"]]
    topic --> consumer["Consumer thread<br/>group activity-log"]
    consumer --> ok{"Processed?"}
    ok -->|"yes"| db[("activity_log<br/>insert, idempotent on event_id")]
    ok -.->|"no: 3 retries,<br/>1 s apart"| dlt[["kanban.activity.dlt"]]
