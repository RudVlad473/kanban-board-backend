%%{init: {"flowchart": {"subGraphTitleMargin": {"top": 15, "bottom": 15}, "curve": "linear"}}}%%
flowchart TB
    client["Internet client<br/>(external actor)"]

    subgraph netcup_edge["[1] Netcup Cloud Firewall (external — not in this repo)"]
        direction TB
        netcup_fw["Netcup Cloud Firewall<br/>policy: Default<br/>implicit Drop all INCOMING"]
    end

    subgraph vm["Netcup VPS Lite 2 G12s — x86_64<br/>[2] VM host network boundary — dated 2026-09-27"]
        direction TB

        vm_spacer[" "]
        style vm_spacer height:1px,fill:none,stroke:none

        mangle_pre["mangle PREROUTING<br/>-I PREROUTING 1 -i eth0<br/>-j KANBAN-INGRESS"]
        vm_spacer ~~~ mangle_pre
        kanban_ingress["KANBAN-INGRESS<br/>[3] allow RELATED/ESTABLISHED,<br/>allow NEW tcp 22/80/443,<br/>allow icmp, DROP the rest<br/>(mangle table, k3s-era, Docker-independent)"]
        nat_pre["nat PREROUTING<br/>-A PREROUTING -m addrtype<br/>--dst-type LOCAL -j CNI-HOSTPORT-DNAT<br/>-A PREROUTING ... -j KUBE-NODEPORTS"]
        cni_dnat["CNI-HOSTPORT-DNAT<br/>(hostPort DNAT --<br/>svclb-traefik's 80/443)"]

        input["filter INPUT<br/>-P INPUT DROP<br/>ACCEPT tcp dpt:22/80/443<br/>governs host daemons ONLY"]
        sshd["sshd :22<br/>(host daemon, not a Pod)"]

        mangle_pre --> kanban_ingress
        kanban_ingress -- "RETURN (allowed)<br/>continues normal chain traversal" --> nat_pre
        nat_pre --> cni_dnat
        mangle_pre -. "also feeds<br/>(host-daemon path,<br/>unaffected by KANBAN-INGRESS)" .-> input
        input -. "ACCEPT dpt:22 only<br/>reaches a real listener" .-> sshd
    end

    subgraph svclb_box["Pod: svclb-traefik-* — ONLY hostPort-carrying Pod in the cluster"]
        svclb["svclb-traefik<br/>hostPort 80, 443"]
    end
    subgraph traefik_box["Pod: traefik — namespace kube-system"]
        traefik["Traefik<br/>ClientHost preserved<br/>(ETP Local)"]
    end
    subgraph mw_box["Middleware: rateLimit"]
        mw["auth-rate-limit /<br/>general-rate-limit /<br/>grafana-login-rate-limit"]
    end
    subgraph svc_box["Service: app / grafana"]
        svc["ClusterIP Service"]
    end
    subgraph pod_box["Pod: app / kube-prometheus-stack-grafana"]
        pod["target Pod"]
    end

    client --> netcup_fw
    netcup_fw -- "HTTPS :443 via duckdns.org<br/>hostnames (crosses VM boundary)" --> mangle_pre
    cni_dnat -- "DNAT to hostPort 80/443" --> svclb
    svclb -- "proxy to Traefik's<br/>ClusterIP" --> traefik
    traefik -- "IngressRoute match,<br/>attach Middleware" --> mw
    mw -- "under budget: forward" --> svc
    svc --> pod
