# Shape of the nonprod deploy's env file: committed with placeholder values only, no real secret.
#
# The real file lives ONLY at /opt/deploy/kanban-board-nonprod/.env.nonprod on the VM, is never committed,
# and must never be merged into or sourced by the production deploy (.env.prod lives in a separate VM
# directory, /opt/deploy/kanban-board-backend/).

# Docker Hub tag to deploy, the same image the production stack pulls. Use a real tag: `latest` 404s.
#
# Docker Hub does NOT publish a `latest` tag for this repository (observed live); CI publishes one tag per
# commit, named by its short SHA, e.g. the one production's own `app` container is running
# (`docker inspect --format '{{.Config.Image}}' kanban-board-backend-app-1` on the VM).
IMAGE_TAG=6755c84

# Public hostname for the nonprod site block. Not a secret, but kept so the compose file's
# ${APP_DOMAIN_NONPROD} reference has a documented placeholder.
APP_DOMAIN_NONPROD=kanban-board-rud-vlad-473-nonprod.duckdns.org

# Self-hosted Postgres application role/database.
#
# DB_HOST is the shared `postgres` service's Compose-registered name, reached across the Compose-project
# boundary over the external kanban-db network, not a remote endpoint. DB_NAME/DB_USER/DB_PASS here MUST
# hold the identical values as NONPROD_DB_NAME/NONPROD_DB_USER/NONPROD_DB_PASS in the real counterpart of
# `.env.prod.example`: they name the same database and role, created once by production's own Compose
# project's postgres init script (docker/postgres-init/01-create-databases-and-roles.sh), not by anything
# in this stack.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kanban_nonprod
DB_USER=kanban_nonprod_app
DB_PASS=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32
# The JDBC query-string override (2026-08-26) is gone: no TLS listener and no connection pooler sit in
# front of the self-hosted engine. See .env.prod.example's identical note and
# src/main/resources/application.properties for the remaining in-application default.

# CORS placeholder origin: the same local-dev value CorsConfig.java already defaults to, not a guessed
# future frontend hosting URL. app.cors.allowed-origins is already externalized.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Shared-secret header value the reset endpoint checks via MessageDigest.isEqual. Placeholder text only:
# generate a real random value on the VM when populating .env.nonprod (`openssl rand -hex 32`).
APP_RESET_TOKEN=REPLACE_ME_WITH_A_REAL_RANDOM_TOKEN

# Activates the nonprod-only Spring profile that gates the reset controller (@Profile("nonprod")). This
# key must NEVER appear in .env.prod.
SPRING_PROFILES_ACTIVE=nonprod
