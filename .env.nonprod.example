# Shape of the nonprod deploy's env file. This file is committed with placeholder values only --
# no real secret ever belongs here. The real file lives ONLY at
# /opt/deploy/kanban-board-nonprod/.env.nonprod on the VM, is never committed, and must never be
# merged into or sourced by the production deploy (.env.prod lives in a separate VM directory,
# /opt/deploy/kanban-board-backend/).

# Docker Hub tag to deploy -- same image the production stack pulls. Docker Hub does NOT publish a
# `latest` tag for this repository (confirmed live during plan 08-01's bring-up: `latest` 404s) --
# CI publishes one tag per commit, named by that commit's short SHA. Use a real tag, e.g. the
# short SHA production's own `app` container is currently running
# (`docker inspect --format '{{.Config.Image}}' kanban-board-backend-app-1` on the VM).
IMAGE_TAG=6755c84

# Public hostname for the nonprod site block (D-05). Not a secret -- a public DNS name -- but kept
# here so the compose file's ${APP_DOMAIN_NONPROD} reference has a documented placeholder.
APP_DOMAIN_NONPROD=kanban-board-rud-vlad-473-nonprod.duckdns.org

# Neon `nonprod` branch connection fields. DB_HOST MUST be the DIRECT (non "-pooler") endpoint --
# Flyway's session-scoped advisory lock at boot is unsupported through the transaction-mode pooler.
DB_HOST=ep-REPLACE-ME.c-6.eu-central-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASS=REPLACE_ME
# Same shape production uses, no leading "?" -- application.properties' URL template already
# supplies it.
DB_JDBC_PARAMS=sslmode=require&channel_binding=require&prepareThreshold=0

# CORS placeholder origin (D-06) -- the same local-dev value CorsConfig.java already defaults to,
# not a guessed future frontend hosting URL. Zero code change either way; app.cors.allowed-origins
# is already externalized.
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Shared-secret header value the reset endpoint (plan 08-02) checks via MessageDigest.isEqual.
# Placeholder text only -- generate a real random value on the VM when populating .env.nonprod
# (this bring-up used `openssl rand -hex 32`, executed directly on the VM).
APP_RESET_TOKEN=REPLACE_ME_WITH_A_REAL_RANDOM_TOKEN

# Activates the nonprod-only Spring profile -- consumed by plan 08-02's @Profile("nonprod")-gated
# reset controller. This key must NEVER appear in .env.prod (T-08-06).
SPRING_PROFILES_ACTIVE=nonprod
