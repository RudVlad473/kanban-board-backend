# Copy this file to `.env` before running `docker compose up`. The real `.env` is ignored by version
# control; only this template with placeholder values is tracked.
#
# DB_HOST is NOT listed here: docker-compose.yml sets it literally to `postgres` (the compose service
# name), always the right value inside the compose network. Its absence is deliberate, not an omission.

DB_NAME=kanban
DB_USER=kanban
DB_PASS=changeme

# The compose Postgres is published on host port 5433, not 5432 (see docker-compose.yml); host-side
# clients (psql, DBeaver, the Gradle rehearsal task) must connect there.
#
# No DB_PORT= key is added: compose does not pass it into the app container (which reaches Postgres at
# its internal 5432) and Gradle does not read this file, so a key would be inert and misleading, the
# same trap as DB_HOST above.
