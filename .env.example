# Copy this file to `.env` before running `docker compose up`. The real `.env` is git-ignored;
# only this template with placeholder values is tracked.
#
# DB_HOST is NOT listed here: docker-compose.yml sets it literally to `postgres` (the compose
# service name), since inside the compose network that is always the right value. This differs
# from .github/workflows/deploy.yml, which injects DB_HOST as a real secret for the EC2 deploy —
# don't be confused by its absence here, it isn't missing, it's just not interpolated.

DB_NAME=kanban
DB_USER=kanban
DB_PASS=changeme

# The compose Postgres is published on host port 5433, not the well-known 5432 -- see
# docker-compose.yml for why. Host-side clients (psql, DBeaver, the Gradle rehearsal task) must
# connect there. No DB_PORT= key is added here: compose does not pass it into the app container
# (which reaches Postgres over the compose network at its own internal 5432) and Gradle does not
# read this file at all, so a key here would be inert and misleading -- the same trap the
# DB_HOST-is-NOT-listed-here comment above already warns about.
