#!/bin/sh
# Pre-commit gate: secret scan, then formatting, compilation and the non-E2E tests. Never auto-fixes:
# a leaked credential or a formatting violation fails the commit with instructions.
#
# build.gradle points core.hooksPath at .githooks/ on any ./gradlew invocation, so this file needs no
# per-clone setup. Keep it mode 100755 in the index: git silently skips a non-executable hook on Linux
# and macOS.

# Secret scanning: run FIRST, because a staged credential should be refused in seconds, not after the
# ~4 minutes spotlessCheck and fastTest take (docs/CODE_STYLE.md rule 8).
#
# Scans the STAGED DIFF ONLY (`gitleaks git --staged`): full history is CI's job
# (.github/workflows/secret-scan.yml), and a working-tree `gitleaks dir` scan would read gitignored
# *.env/*.pem files this repo never wants a report to touch.
#
# Decisions:
# `gitleaks dir` does NOT respect .gitignore
# (.planning/quick/260816-hn1-wire-up-secret-scanning-gitleaks-truffle/260816-hn1-MEASUREMENTS.md);
# staged-diff mode is immune because git never stages a gitignored path.
# The image is PINNED to an exact tag+digest, and the pin is load-bearing: every gate in this file
# except the deliberately unpinned, report-only NVD/OWASP scan is a pure function of the commit, and an
# unpinned `:latest` could red an unchanged commit when a new gitleaks rule ships (the failure
# security-scan.yml documents for another tool). secret-scan.yml pins the byte-identical reference; if
# either drifts, the two gates could disagree.
# Mount strategy: worktrees nest under .claude/worktrees/<name>. A worktree's private git-dir cannot be
# bind-mounted standalone, because its `commondir` file holds a RELATIVE path back to the shared object
# database; a standalone mount severs it and silently yields "0 commits scanned", a false clean (see the
# MEASUREMENTS file above). Mount instead the common ancestor of the private git-dir and the work tree,
# `dirname "$(git rev-parse --path-format=absolute --git-common-dir)"` (right for worktrees and plain
# checkouts alike), and pass GIT_DIR/GIT_WORK_TREE as absolute paths inside that mount, bypassing the
# `.git`-file indirection, which holds a host-OS absolute path meaningless inside the container.
# Out-of-tree worktrees (created OUTSIDE this repo's tree) share no mountable ancestor with their
# git-dir, so mounting only the work tree reproduces the original false clean in a new shape. They fall
# back to `git diff --cached | gitleaks stdin`, gitleaks' own documented pre-commit pattern. Accepted
# trade-off: the piped diff carries filenames only as diff headers, so path-scoped allowlist entries
# cannot match. That costs nothing today, since every `.gitleaks.toml` allowlist is rule-scoped
# (`regexTarget = "match"`); it would matter only if a path-scoped entry were ever added.
GITLEAKS_IMAGE='ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f'

echo "Scanning staged diff for secrets..."

GIT_TOPLEVEL=$(git rev-parse --show-toplevel)
GIT_COMMON_DIR=$(git rev-parse --path-format=absolute --git-common-dir)
GIT_PRIVATE_DIR=$(git rev-parse --path-format=absolute --git-dir)
MOUNT_ROOT=$(dirname "$GIT_COMMON_DIR")

if [ "$GIT_TOPLEVEL" = "$MOUNT_ROOT" ]; then
  # Plain checkout: the work tree IS the mount root, nothing to strip.
  REL_WORKTREE=""
else
  REL_WORKTREE=${GIT_TOPLEVEL#"$MOUNT_ROOT"/}
fi
REL_GITDIR=${GIT_PRIVATE_DIR#"$MOUNT_ROOT"/}

CONTAINER_WORKTREE="/repo${REL_WORKTREE:+/$REL_WORKTREE}"
CONTAINER_GITDIR="/repo/$REL_GITDIR"

# Run the scan in one of two shapes, chosen by where the work tree sits.
#
# Decisions:
# MSYS_NO_PATHCONV=1: Git Bash on Windows rewrites Docker's Windows-style path arguments before they
# reach docker.exe, turning the -v mount source into a nonsense concatenated path (reproduced in the
# MEASUREMENTS file above). No effect on Linux/macOS.
# --exit-code 2 remaps ONLY "leaks found" away from gitleaks' generic-error code (1), which makes the
# three-way branch below possible: 0 = clean, 2 = findings, anything else (docker unable to reach a
# stopped daemon, a real gitleaks tool error) = "could not run". Verified empirically that tool-level
# failures such as an unreadable config still exit 1.
# --verbose is required: without it gitleaks prints only "leaks found: N" and the refusal below, which
# points at "the Finding/RuleID/File lines above", would reference output never printed. --redact masks
# the secret VALUE regardless, so verbosity adds file:line detail without adding exposure.
# The "$MOUNT_ROOT"|"$MOUNT_ROOT"/* branch covers a plain checkout and this repo's nested
# `.claude/worktrees/<name>` convention; the `*` fallback covers a worktree not reachable under the same
# mount root as its private git-dir.
case "$GIT_TOPLEVEL" in
  "$MOUNT_ROOT"|"$MOUNT_ROOT"/*)
    MSYS_NO_PATHCONV=1 docker run --rm \
      -v "${MOUNT_ROOT}:/repo" \
      -e GIT_DIR="${CONTAINER_GITDIR}" \
      -e GIT_WORK_TREE="${CONTAINER_WORKTREE}" \
      "${GITLEAKS_IMAGE}" \
      git --staged --redact --no-banner --verbose --exit-code 2 "${CONTAINER_WORKTREE}"
    GITLEAKS_STATUS=$?
    ;;
  *)
    # Out-of-tree worktree fallback: pipe the staged diff into gitleaks' `stdin` mode, with no bind mount
    # and no GIT_DIR/GIT_WORK_TREE indirection.
    #
    # MSYS_NO_PATHCONV is deliberately NOT set: it stops Git Bash from rewriting Docker path ARGUMENTS, and
    # this invocation passes no path argument and mounts no volume. `VAR=x cmd1 | cmd2` would scope it to
    # `git diff` only anyway; do not copy that placement forward believing it load-bearing.
    # `-i` is required: without it the container gets no stdin and silently scans an empty stream, the same
    # false clean in a new costume. The other flags match the bind-mount branch exactly, so the
    # GITLEAKS_STATUS contract below is identical on either branch.
    git diff --cached | docker run --rm -i \
      "${GITLEAKS_IMAGE}" \
      stdin --redact --no-banner --verbose --exit-code 2
    GITLEAKS_STATUS=$?
    ;;
esac

if [ "$GITLEAKS_STATUS" -eq 0 ]; then
  echo "No secrets found in staged diff."
elif [ "$GITLEAKS_STATUS" -eq 2 ]; then
  echo "Secret scan found a likely credential in the staged diff (see the Finding/RuleID/File"
  echo "lines above - the secret VALUE itself is redacted, never printed). Commit refused."
  echo "Remove it, or if this is a genuine false positive, add a narrow, evidence-cited"
  echo "allowlist entry to .gitleaks.toml (never a blanket path/directory exemption) and"
  echo "re-commit."
  exit 1
else
  echo "Secret scan did not run to completion (exit code ${GITLEAKS_STATUS}, expected 0 or 2)."
  echo "Most likely cause: the Docker daemon is not running, or the pinned gitleaks image"
  echo "could not be pulled. Commit refused rather than silently skipping the scan - start"
  echo "Docker Desktop (or otherwise restore the scanner) and re-commit. This is a distinct"
  echo "failure from 'a secret was found' (see above); conflating the two - passing a commit"
  echo "because the scanner could not run - is exactly the silent-drift failure mode"
  echo ".github/workflows/security-scan.yml's preflight step already rejects for a different"
  echo "tool, and this hook does not reintroduce it here."
  exit 1
fi

# Comment policy is fail-open without Python 3 because CI is the backstop; refusing every commit would
# block contributors who cannot run this stdlib-only gate locally.
COMMENT_PYTHON=""
if command -v python3 >/dev/null 2>&1; then
  COMMENT_PYTHON=$(command -v python3)
elif command -v python >/dev/null 2>&1 && python --version 2>&1 | grep -Eq '^Python 3\.'; then
  COMMENT_PYTHON=$(command -v python)
fi

if [ -n "$COMMENT_PYTHON" ]; then
  echo "Checking code-comment policy..."
  "$COMMENT_PYTHON" scripts/verify-comments.py check < /dev/null
  if [ $? -ne 0 ]; then
    echo "Comment policy check failed (docs/CODE_STYLE.md rule 14). Commit refused."
    exit 1
  fi
else
  echo "WARNING: Python 3 is unavailable; skipping code-comment policy check. CI comment-lint remains required."
fi

echo "Checking formatting..."
./gradlew spotlessCheck < /dev/null
if [ $? -ne 0 ]; then
  echo "Formatting check failed. Run ./gradlew spotlessApply and re-commit."
  exit 1
fi

# One `fastTest` invocation (build.gradle) covers "project compiles" and "fast tests pass".
#
# It includes ArchUnit's LayeringArchTest and the unit/service tests, and excludes @Tag("kafka") and
# @Tag("realSocket") classes: a new test class runs here by default and earns a tag only if it genuinely
# needs Kafka or a real socket.
echo "Compiling and running fast tests..."
./gradlew fastTest < /dev/null
if [ $? -ne 0 ]; then
  echo "Compile or test failure. Commit aborted."
  exit 1
fi
