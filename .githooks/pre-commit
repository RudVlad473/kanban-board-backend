#!/bin/sh
# Auto-installed: build.gradle points core.hooksPath at .githooks/ on any ./gradlew
# invocation, so this file needs no per-clone setup. Keep it mode 100755 in the
# index - git silently skips a non-executable hook on Linux and macOS.
#
# Gate: formatting is correct, the project compiles, and the non-E2E test suite
# passes. Does not auto-fix anything - a formatting violation fails the commit
# with instructions instead of silently rewriting staged files.
echo "Checking formatting..."
./gradlew spotlessCheck < /dev/null
if [ $? -ne 0 ]; then
  echo "Formatting check failed. Run ./gradlew spotlessApply and re-commit."
  exit 1
fi

# `fastTest` (build.gradle) depends on compileJava/compileTestJava, so this single
# invocation covers both "project compiles" and "non-E2E tests pass". E2E classes
# (suffixed E2ETest) are excluded - see build.gradle's fastTest task. Still runs
# ArchUnit's LayeringArchTest plus all unit/service tests, so ownership-layering
# and Error Prone regressions are caught before the commit lands, not first in CI.
echo "Compiling and running non-E2E tests..."
./gradlew fastTest < /dev/null
if [ $? -ne 0 ]; then
  echo "Compile or test failure. Commit aborted."
  exit 1
fi
