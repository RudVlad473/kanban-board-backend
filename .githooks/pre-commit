#!/bin/sh
# Auto-installed: build.gradle points core.hooksPath at .githooks/ on any ./gradlew
# invocation, so this file needs no per-clone setup. Keep it mode 100755 in the
# index - git silently skips a non-executable hook on Linux and macOS.
# Part 1 Assign all staged files to a variable
stagedFiles=$(git diff --staged --name-only)
echo "Running spotlessApply. Formatting code..."

# Part 2 Apply the formatting
./gradlew spotlessApply

# Part 3 Re-add staged files
for file in $stagedFiles; do
  if test -f "$file"; then
    git add $file
  fi
done

# Part 4 Run the fast local test gate: the `fastTest` Gradle task (build.gradle)
# runs everything except the Testcontainers-backed E2E suite (every E2E class is
# suffixed E2ETest). The default `test` task is untouched, so `./gradlew test` run
# directly (and in CI) still executes everything, E2E included. Still runs
# ArchUnit's LayeringArchTest plus all unit/service tests, so ownership-layering
# and Error Prone regressions are caught before the commit lands, not first in CI.
echo "Running fast test suite (excluding E2E tests)..."
./gradlew fastTest
if [ $? -ne 0 ]; then
  echo "Tests failed. Commit aborted."
  exit 1
fi