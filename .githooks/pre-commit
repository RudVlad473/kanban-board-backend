#!/bin/sh
# Auto-installed: build.gradle points core.hooksPath at .githooks/ on any ./gradlew
# invocation, so this file needs no per-clone setup. Keep it mode 100755 in the
# index - git silently skips a non-executable hook on Linux and macOS.
# Part 1 Assign all staged files to a variable
stagedFiles=$(git diff --staged --name-only)
echo "Running spotlessApply. Formatting code..."

# Part 2 Apply the formatting
./gradlew spotlessApply

# Part 3 Re-add staged files
for file in $stagedFiles; do
  if test -f "$file"; then
    git add $file
  fi
done