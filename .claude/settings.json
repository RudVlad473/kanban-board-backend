{
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" && ./gradlew --stop >/dev/null 2>&1 || true",
            "statusMessage": "Releasing Gradle daemon",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
