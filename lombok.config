# Stamp @lombok.Generated on Lombok's generated members so JaCoCo excludes them from coverage.
#
# Why this is the way it is:
# Lombok's getters/setters/builders/equals/hashCode are woven into the same .class file as the
# hand-written code, so JaCoCo cannot exclude them by path or class-file pattern. Its built-in
# filter for members carrying @lombok.Generated (since 0.8.2) only fires when Lombok stamps the
# annotation, which it does NOT do by default. Without this setting every
# @Getter/@Setter/@Builder/@EqualsAndHashCode member counts against the coverage denominator and
# deflates the hand-written-code number.
lombok.addLombokGeneratedAnnotation = true

# Stop Lombok searching parent directories, so no unrelated lombok.config (e.g. a machine-wide
# one) from outside the project is merged in.
config.stopBubbling = true
