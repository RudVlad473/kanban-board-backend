[Unit]
Description=Apply the KANBAN-INGRESS mangle-table ingress filter for k3s NodePorts/hostPorts
# No After/Requires/PartOf against docker.service or k3s.service: neither touches mangle PREROUTING.
#
# Checked with `iptables -t mangle -S PREROUTING` before and after `systemctl restart k3s`: the jump
# stayed first with no reapplication. network-online.target IS a dependency: applying the rule before
# eth0 is up is a no-op that silently drifts until the next boot or manual re-apply.
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/k3s-host-firewall.sh apply
ExecStop=/usr/local/sbin/k3s-host-firewall.sh remove

[Install]
WantedBy=multi-user.target
