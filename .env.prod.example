# Example environment file for docker-compose.prod.yml.
#
# The REAL file (`.env.prod`) lives only on the Netcup VPS (docs/INFRA_RUNBOOK.md) and in GitHub Actions
# secrets, and must NEVER be committed. Every value below is a placeholder name, not a credential. Copy
# this file to `.env.prod` on the VM (or inject the same names via GitHub Actions secrets) and fill in
# real values there.

# Docker Hub tag to pull -- set by the human during a manual deploy, later set by the CI/CD
# pipeline to the short SHA of the just-built image.
IMAGE_TAG=latest

# Self-hosted Postgres 16: one container serving this environment's own database AND nonprod's (see the
# crossover block below).
#
# Every password in this file, including these two, must be generated on the VM with `openssl rand -hex
# 32`: hex output has no quoting hazard, and the postgres-init script embeds these values inside
# single-quoted SQL literals, so a password containing an apostrophe would break first-boot provisioning
# in a way that is hard to read from the container log.
POSTGRES_SUPERUSER=kanban_admin
POSTGRES_SUPERUSER_PASS=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# Production application role/database -- DB_HOST is the Compose service name `postgres`, not a
# remote endpoint; the connection never leaves the VM's own Docker network.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kanban_prod
DB_USER=kanban_prod_app
DB_PASS=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# Nonprod crossover block: this production env file deliberately also carries the NONPROD environment's
# database credentials.
#
# Decisions:
# The shared Postgres instance's init script is defined in production's own Compose project
# (docker-compose.prod.yml) and needs both environments' role credentials at container first boot. The
# NONPROD_ prefix exists so a future reader or access review reads this as an accepted design
# consequence, not a leak. NONPROD_DB_NAME/NONPROD_DB_USER/NONPROD_DB_PASS here MUST hold the identical
# values as DB_NAME/DB_USER/DB_PASS in the real counterpart of `.env.nonprod.example`: they name the same
# database and role, created once by this file's own postgres service and consumed by the other Compose
# project's app-nonprod service.
NONPROD_DB_NAME=kanban_nonprod
NONPROD_DB_USER=kanban_nonprod_app
NONPROD_DB_PASS=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# The JDBC query-string override (formerly DB_URL_PARAMS, DB_JDBC_PARAMS) was removed on 2026-08-26.
#
# TLS/channel-binding are dropped because the hop from `app` to `postgres` is now a Docker bridge, not the
# public internet, and the prepared-statement threshold override is gone because no connection pooler
# sits in front of the self-hosted engine. See src/main/resources/application.properties for the
# remaining in-application default.

# Free subdomain hostname Caddy requests a Let's Encrypt certificate for. Must be a real, DNS-resolvable
# hostname pointed at the VM's Reserved (static) public IP before Caddy can complete the HTTP-01
# challenge.
APP_DOMAIN=your-subdomain.duckdns.org

# Public hostname for the nonprod site block Caddy also fronts. Not a secret; documented here because
# caddy's environment block reads it. Matches .env.nonprod.example's APP_DOMAIN_NONPROD.
APP_DOMAIN_NONPROD=your-nonprod-subdomain.duckdns.org

# Grafana public hostname and admin credential for the self-hosted observability stack.
#
# APP_DOMAIN_MONITORING follows the same {$APP_DOMAIN_MONITORING} Caddy placeholder pattern as APP_DOMAIN and
# APP_DOMAIN_NONPROD above: an enumerated DuckDNS subdomain, never a wildcard (the Caddyfile's site-block
# comments explain why). GRAFANA_ADMIN_PASSWORD gates every metric collected and every container's logs
# across both environments, so treat it with the same care as POSTGRES_SUPERUSER_PASS, not as a throwaway
# internal-tool password.
APP_DOMAIN_MONITORING=kanban-board-rud-vlad-473-monitoring.duckdns.org
GRAFANA_ADMIN_PASSWORD=changeme

MONITORING_DB_PASS=changeme
