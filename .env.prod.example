# Example environment file for docker-compose.prod.yml.
#
# The REAL file (`.env.prod`) lives only on the Netcup VPS (v1.2 Phase 5 deploy target -- see
# docs/INFRA_RUNBOOK.md; superseded the original Oracle Cloud A1 Flex plan) and in GitHub Actions
# secrets -- it must NEVER be committed to this repository. Every value below is a placeholder
# name, not a real credential. Copy this file to `.env.prod` on the VM (or inject the same names
# via GitHub Actions secrets) and fill in real values there.

# Docker Hub tag to pull -- set by the human during a manual deploy, later set by the CI/CD
# pipeline to the short SHA of the just-built image.
IMAGE_TAG=latest

# Self-hosted Postgres 16 (phase 11, replacing Neon) -- one container serving both this
# environment's own database AND, per D-01, nonprod's database too (see the crossover block
# below). Every password in this file, including these two, must be generated on the VM with
# `openssl rand -hex 32`: hex output has no quoting hazard, and the postgres-init script embeds
# these values inside single-quoted SQL literals -- a password containing an apostrophe would
# break first-boot provisioning in a way that is hard to read from the container log.
POSTGRES_SUPERUSER=kanban_admin
POSTGRES_SUPERUSER_PASS=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# Production application role/database -- DB_HOST is the Compose service name `postgres`, not a
# remote endpoint; the connection never leaves the VM's own Docker network.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=kanban_prod
DB_USER=kanban_prod_app
DB_PASS=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# Nonprod crossover block (phase 11, D-01, RESEARCH.md Pitfall 5) -- this production env file
# deliberately also carries the NONPROD environment's database credentials. Why: the shared
# Postgres instance's init script is defined in production's own Compose project
# (docker-compose.prod.yml), and it needs both environments' role credentials at container
# first-boot. The NONPROD_ prefix exists precisely so a future reader or access review reads this
# as an accepted design consequence, not a leak. NONPROD_DB_NAME/NONPROD_DB_USER/NONPROD_DB_PASS
# here MUST hold the identical values as DB_NAME/DB_USER/DB_PASS in .env.nonprod.example's real
# counterpart -- they name the same database and role, created once by this file's own postgres
# service, consumed by the other Compose project's app-nonprod service.
NONPROD_DB_NAME=kanban_nonprod
NONPROD_DB_USER=kanban_nonprod_app
NONPROD_DB_PASS=REPLACE_ME_WITH_OPENSSL_RAND_HEX_32

# Removed phase 11 (2026-08-26): the JDBC query-string override (formerly DB_URL_PARAMS, before
# that DB_JDBC_PARAMS) is gone. TLS/channel-binding are dropped because the hop from `app` to
# `postgres` is now a Docker bridge, not the public internet; the prepared-statement threshold
# override is gone because no connection pooler sits in front of the self-hosted engine any more.
# See src/main/resources/application.properties for the remaining in-application default and
# plan 11-04 for where that default was decided.

# Free subdomain hostname Caddy requests a Let's Encrypt certificate for (D-01, plan 05-03).
# Must be a real, DNS-resolvable hostname pointed at the VM's Reserved (static) public IP before
# Caddy can complete the HTTP-01 challenge.
APP_DOMAIN=your-subdomain.duckdns.org

# Public hostname for the nonprod site block Caddy also fronts (D-05, plan 08-01). Not a secret --
# a public DNS name -- but documented here since caddy's environment block reads it. Matches the
# same value .env.nonprod.example's own APP_DOMAIN_NONPROD documents.
APP_DOMAIN_NONPROD=your-nonprod-subdomain.duckdns.org
