# Example environment file for docker-compose.prod.yml.
#
# The REAL file (`.env.prod`) lives only on the Oracle VM and in GitHub Actions secrets -- it must
# NEVER be committed to this repository. Every value below is a placeholder name, not a real
# credential. Copy this file to `.env.prod` on the VM (or inject the same names via GitHub Actions
# secrets, see the "Exact New GitHub Secrets Needed" table in 05-RESEARCH.md) and fill in real
# values there.

# Docker Hub tag to pull -- set by the human during plan 05-04's manual deploy, later set by the
# CI/CD pipeline (plan 05-05) to the short SHA of the just-built image.
IMAGE_TAG=latest

# Neon serverless Postgres pooled (`-pooler`) endpoint hostname, from the Neon dashboard.
DB_HOST=your-project-pooler.region.aws.neon.tech
# Neon's Postgres port -- 5432 is the default and normally does not need overriding.
DB_PORT=5432
# Neon database name, from the Neon dashboard.
DB_NAME=kanban_board
# Neon role/username, from the Neon dashboard.
DB_USER=your_neon_role
# Neon role password, from the Neon dashboard.
DB_PASS=your_neon_password
# Production value for plan 05-01's JDBC URL query-string placeholder: TLS required, channel
# binding required, PgJDBC server-side prepared-statement reuse disabled (mitigates PgBouncer
# transaction-mode pooling breaking Hibernate's prepared-statement behavior). Must start with "?".
DB_URL_PARAMS=?sslmode=require&channel_binding=require&prepareThreshold=0

# Free subdomain hostname Caddy requests a Let's Encrypt certificate for (D-01), chosen at
# execution time in plan 05-03 (e.g. a DuckDNS hostname). Must be a real, DNS-resolvable hostname
# pointed at the VM's Reserved (static) public IP before Caddy can complete the HTTP-01 challenge.
APP_DOMAIN=your-subdomain.duckdns.org
